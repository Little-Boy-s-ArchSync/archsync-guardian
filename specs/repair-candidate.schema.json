{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://archsync.dev/contracts/repair-candidate/0.1",
  "title": "ArchSync Repair Candidate Contract 0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "status", "patch", "target_files", "rationale", "expected_architecture_impact", "risk", "verification_commands", "rollback"],
  "properties": {
    "contract_version": { "const": "0.1" },
    "status": { "enum": ["PROPOSED", "VERIFIED_FOR_REVIEW"] },
    "patch": { "type": "string", "minLength": 1 },
    "target_files": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "rationale": { "type": "string", "minLength": 1 },
    "expected_architecture_impact": { "type": "string", "minLength": 1 },
    "risk": { "enum": ["low", "medium", "high", "critical"] },
    "verification_commands": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "rollback": { "type": "string", "minLength": 1 },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tests", "conformance", "safe_apply", "new_blocking_findings"],
      "properties": {
        "tests": { "enum": ["pass", "fail", "not-run"] },
        "conformance": { "enum": ["pass", "fail", "not-run"] },
        "safe_apply": { "type": "boolean" },
        "new_blocking_findings": { "type": "integer", "minimum": 0 }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "VERIFIED_FOR_REVIEW" } } },
      "then": { "required": ["verification"] }
    }
  ]
}
