{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://archsync.dev/contracts/repair-candidate/0.1.0-preparatory",
  "title": "ArchSync Canonical Repair Candidate Contract 0.1.0-preparatory",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "candidate_id",
    "status",
    "target_block_finding_fingerprints",
    "files",
    "unified_diff",
    "rationale",
    "expected_architecture_impact",
    "risk",
    "verification_commands",
    "rollback"
  ],
  "properties": {
    "schema_version": { "const": "0.1.0-preparatory" },
    "candidate_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
    "status": { "enum": ["PROPOSED", "VERIFIED_FOR_REVIEW"] },
    "target_block_finding_fingerprints": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "base_sha256"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "base_sha256": {
            "oneOf": [
              { "type": "string", "pattern": "^[a-f0-9]{64}$" },
              { "type": "null" }
            ]
          }
        }
      }
    },
    "unified_diff": { "type": "string", "minLength": 1, "maxLength": 1048576 },
    "rationale": { "type": "string", "minLength": 1 },
    "expected_architecture_impact": { "type": "string", "minLength": 1 },
    "risk": { "enum": ["low", "medium", "high", "critical"] },
    "verification_commands": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "rollback": { "type": "string", "minLength": 1 },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "tests", "conformance", "safe_apply", "new_blocking_findings"],
      "properties": {
        "decision": {
          "enum": [
            "ACCEPTABLE_FOR_REVIEW",
            "REJECT_TEST",
            "REJECT_CONFORMANCE",
            "REJECT_UNSAFE",
            "INCONCLUSIVE"
          ]
        },
        "tests": { "enum": ["pass", "fail", "not-run"] },
        "conformance": { "enum": ["pass", "fail", "not-run"] },
        "safe_apply": { "type": "boolean" },
        "new_blocking_findings": { "type": "integer", "minimum": 0 }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "VERIFIED_FOR_REVIEW" } } },
      "then": { "required": ["verification"] }
    }
  ]
}
