{
  "forbidden": [],
  "options": {
    "moduleSystems": [
      "es6"
    ],
    "tsPreCompilationDeps": true,
    "exclude": {
      "dynamic": true
    },
    "tsConfig": {
      "fileName": "tsconfig.json"
    },
    "doNotFollow": {
      "path": "^(?!(?:src/app\\.ts|src/common\\.ts|src/dynamic\\.ts|src/equals\\.ts|src/static\\.ts|src/type-expression\\.ts)$)"
    }
  }
}
